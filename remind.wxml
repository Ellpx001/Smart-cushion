<view class="remind-page">
  <!-- 页面标题 -->
  <view class="page-title">提醒设置</view>

  <!-- 提醒阈值设置 -->
  <view class="setting-card">
    <view class="card-title">坐姿不端正提醒阈值</view>
    <view class="slider-area">
      <text class="slider-label">{{remindTime}} 秒</text>
      <slider 
        min="5" 
        max="30" 
        step="1" 
        value="{{remindTime}}" 
        bindchange="onRemindTimeChange"
        activeColor="#1890ff"
      ></slider>
      <text class="tips">坐姿不端正超过设定时间触发提醒</text>
    </view>
  </view>

  <!-- 提醒方式 -->
  <view class="setting-card">
    <view class="card-title">提醒方式</view>
    <view class="radio-group">
      <label class="radio-item">
        <radio 
          value="vibrate" 
          checked="{{remindType === 'vibrate'}}" 
          bindchange="onRemindTypeChange"
        ></radio>
        <text>震动提醒</text>
      </label>
      <label class="radio-item">
        <radio 
          value="sound" 
          checked="{{remindType === 'sound'}}" 
          bindchange="onRemindTypeChange"
        ></radio>
        <text>声音提醒</text>
      </label>
      <label class="radio-item">
        <radio 
          value="both" 
          checked="{{remindType === 'both'}}" 
          bindchange="onRemindTypeChange"
        ></radio>
        <text>震动+声音</text>
      </label>
    </view>
  </view>

  <!-- 每日监测时段 -->
  <view class="setting-card">
    <view class="card-title">每日监测时段</view>
    <view class="time-picker-area">
      <view class="time-item">
        <text class="time-label">开始时间：</text>
        <picker mode="time" value="{{startTime}}" bindchange="onStartTimeChange">
          <view class="picker-text">{{startTime}}</view>
        </picker>
      </view>
      <view class="time-item">
        <text class="time-label">结束时间：</text>
        <picker mode="time" value="{{endTime}}" bindchange="onEndTimeChange">
          <view class="picker-text">{{endTime}}</view>
        </picker>
      </view>
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="save-btn-area">
    <button class="save-btn" bindtap="saveRemindSetting">保存设置</button>
  </view>
</view>