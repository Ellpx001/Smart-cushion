/* pages/help/help.wxss */
.help-page {
  background-color: #f5f7fa;
  min-height: 100vh;
  padding: 30rpx 20rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
}

/* 常见问题 */
.faq-section {
  margin-bottom: 30rpx;
}

.faq-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.faq-item {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.faq-question {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.arrow {
  font-size: 24rpx;
  color: #ccc;
}

.faq-answer {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  padding-top: 10rpx;
  border-top: 1rpx solid #f0f0f0;
}

/* 使用教程 */
.tutorial-section {
  margin-bottom: 30rpx;
}

.tutorial-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.tutorial-item {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.tutorial-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
  width: 60rpx;
  text-align: center;
}

.tutorial-info {
  flex: 1;
}

.tutorial-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 6rpx;
}

.tutorial-desc {
  font-size: 24rpx;
  color: #666;
}

/* 联系我们 */
.contact-section {
  margin-bottom: 30rpx;
}

.contact-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.contact-item {
  display: flex;
  margin-bottom: 16rpx;
  font-size: 26rpx;
}

.contact-label {
  color: #333;
  width: 120rpx;
}

.contact-value {
  flex: 1;
  color: #666;
}

.contact-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background-color: #1890ff;
  color: #fff;
  font-size: 28rpx;
  border: none;
  border-radius: 12rpx;
  margin-top: 10rpx;
}