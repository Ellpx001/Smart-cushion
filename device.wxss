/* pages/device/device.wxss */
.device-page {
  background-color: #f5f7fa;
  min-height: 100vh;
  padding: 30rpx 20rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 30rpx;
}

/* 蓝牙状态 */
.bluetooth-status {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.status-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.status-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.status-btn {
  font-size: 26rpx;
  color: #1890ff;
  background: none;
  border: 1rpx solid #1890ff;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
}

/* 设备列表 */
.device-list, .search-result {
  margin-bottom: 30rpx;
}

.list-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
}

.device-item {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 10rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.device-info {
  flex: 1;
}

.device-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 6rpx;
}

.device-status {
  font-size: 24rpx;
  color: #52c41a;
}

.device-signal {
  font-size: 24rpx;
  color: #666;
}

/* 按钮样式 */
.connect-btn {
  font-size: 26rpx;
  color: #1890ff;
  background: none;
  border: 1rpx solid #1890ff;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  margin-right: 10rpx;
}

.unbind-btn, .bind-btn {
  font-size: 26rpx;
  color: #ff4d4f;
  background: none;
  border: 1rpx solid #ff4d4f;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
}

.bind-btn {
  color: #52c41a;
  border-color: #52c41a;
}

/* 操作区域 */
.operate-area {
  margin-bottom: 30rpx;
}

.search-btn {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  background-color: #1890ff;
  color: #fff;
  font-size: 32rpx;
  border: none;
  border-radius: 12rpx;
}