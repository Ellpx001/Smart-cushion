/* pages/record/record.wxss */
.record-page {
  background-color: #f5f7fa;
  min-height: 100vh;
  padding: 30rpx 20rpx;
}

.header {
  margin-bottom: 30rpx;
}
.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 20rpx;
}
.time-switch {
  display: flex;
  justify-content: center;
  gap: 10rpx;
}
.time-btn {
  font-size: 26rpx;
  color: #666;
  background-color: #fff;
  border: 1rpx solid #e0e0e0;
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
}
.time-btn.active {
  background-color: #3498db;
  color: #fff;
  border-color: #3498db;
}

/* 图表容器样式（关键：保证canvas有尺寸） */
.chart-container {
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
  width: 100%;
  height: 300rpx; /* 固定高度，避免canvas尺寸为0 */
}
.chart-canvas {
  width: 60%;
  height: 100%; /* 继承容器高度 */
}

.stats-container {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 40rpx;
}
.stat-card {
  display: flex;
  align-items: center;
  background-color: #fff;
  padding: 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}
.stat-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  width: 60rpx;
  text-align: center;
}
.stat-info { flex: 1; }
.stat-text {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 4rpx;
}
.stat-time {
  font-size: 24rpx;
  color: #666;
}
.correct { border-left: 8rpx solid #52c41a; }
.forward { border-left: 8rpx solid #ff7a45; }
.backward { border-left: 8rpx solid #ff6b6b; }
.left { border-left: 8rpx solid #40a9ff; }
.right { border-left: 8rpx solid #722ed1; }

.export-area {
  text-align: center;
}
.export-btn {
  width: 60%;
  height: 90rpx;
  line-height: 90rpx;
  background-color: #3498db;
  color: #fff;
  font-size: 32rpx;
  border: none;
  border-radius: 12rpx;
}